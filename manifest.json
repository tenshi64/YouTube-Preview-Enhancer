{
    "manifest_version": 3,
    "name": "YouTube Preview Enhancer",
    "description": "Improve your video discovery on YouTube: take full control of YouTube previews with built-in volume sliders and more!",
    "version": "1.1.2",
    "author": "tenshi",
    "developer": {
        "name": "tenshi"
    },
    "icons": {
        "16": "/images/icon.png",
        "48": "/images/icon.png",
        "128": "/images/icon.png"
    },
    "content_scripts": [{
        "matches": [
            "*://www.youtube.com/*",
            "*://m.youtube.com/*",
            "*://youtube.com/*"
        ],
        "js": ["/scripts/extension.js"],
        "run_at": "document_end"
    }],
    "action": {
        "default_popup": "/options/options.html"
    },
    "options_ui": {
        "page": "/options/options.html",
        "open_in_tab": true
    },
    "permissions": [
        "storage"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "{b8f4e2a1-7c9d-4e3b-8a1f-5d6c9e2b4a70}",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
